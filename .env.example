# Local development only (docker compose + `./dev run`). These values match the defaults in
# docker-compose.yml and application-local.yml. Production secrets are set in the platform, never here.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=patientvault
DB_USER=patientvault
DB_PASSWORD=patientvault

COUCHDB_USER=admin
COUCHDB_PASSWORD=admin-dev-password

SMTP_HOST=localhost
SMTP_PORT=1025
# Production mail (the local profile ignores these and uses Mailpit):
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM=PatientVault <no-reply@example.com>
# APP_PUBLIC_BASE_URL=https://patientvault.example.com
# APP_DOCTOR_NOTIFICATION_EMAIL=doctor@example.com
