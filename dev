#!/usr/bin/env bash
# Local development shortcuts: ./dev up | down | logs | run | reset | genkey
set -euo pipefail
cd "$(dirname "$0")"

SECRETS_FILE=.dev-secrets.env   # git-ignored; local development keys only, never reuse in production

genkey() {
  openssl rand -base64 32
}

ensure_dev_secrets() {
  if [[ ! -f "$SECRETS_FILE" ]]; then
    umask 077
    {
      echo "export APP_MASTER_KEYS=v1:$(genkey)"
      echo "export APP_ACTIVE_KEY_ID=v1"
    } > "$SECRETS_FILE"
    echo "Generated local development keys in $SECRETS_FILE"
  fi
}

case "${1:-}" in
  up)     docker compose up -d --build --wait postgres couchdb mailpit ;;
  down)   docker compose down ;;
  logs)   docker compose logs -f ;;
  run)    ensure_dev_secrets
          # shellcheck disable=SC1090
          source "$SECRETS_FILE"
          SPRING_PROFILES_ACTIVE=local ./mvnw spring-boot:run ;;
  reset)  docker compose down -v ;;
  genkey) echo "v1:$(genkey)" ;;
  *)      echo "usage: ./dev {up|down|logs|run|reset|genkey}"; exit 1 ;;
esac
