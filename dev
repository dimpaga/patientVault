#!/usr/bin/env bash
# Local development shortcuts: ./dev up | down | logs | run | reset | genkey
set -euo pipefail
cd "$(dirname "$0")"

SECRETS_FILE=.dev-secrets.env   # git-ignored; local development secrets only, never reuse in production

genkey() {
  openssl rand -base64 32
}

ensure_dev_secrets() {
  touch "$SECRETS_FILE"
  chmod 600 "$SECRETS_FILE"
  if ! grep -q '^export APP_MASTER_KEYS=' "$SECRETS_FILE"; then
    {
      echo "export APP_MASTER_KEYS=v1:$(genkey)"
      echo "export APP_ACTIVE_KEY_ID=v1"
    } >> "$SECRETS_FILE"
    echo "Generated local development encryption keys in $SECRETS_FILE"
  fi
  if ! grep -q '^export S3_BUCKET=' "$SECRETS_FILE"; then
    {
      echo "# Local S3 emulator (docker compose). To use a real test bucket instead, replace these lines with:"
      echo "#   export S3_BUCKET=<bucket>  S3_REGION=<region>  S3_ACCESS_KEY_ID=<key>  S3_SECRET_ACCESS_KEY=<secret>"
      echo "export S3_BUCKET=patientvault-files-local"
      echo "export S3_REGION=eu-central-1"
      echo "export S3_ENDPOINT=http://localhost:9090"
      echo "export S3_ACCESS_KEY_ID=local"
      echo "export S3_SECRET_ACCESS_KEY=local-dev-only"
      echo "export APP_STORAGE_S3_PATH_STYLE=true"
      echo "export APP_STORAGE_S3_SSE=NONE"
      echo "export APP_STORAGE_S3_CONDITIONAL_WRITES=false"
    } >> "$SECRETS_FILE"
    echo "Added local S3 emulator settings to $SECRETS_FILE"
  fi
  if ! grep -q '^export APP_BOOTSTRAP_PASSWORD=' "$SECRETS_FILE"; then
    local password
    password="$(openssl rand -base64 18 | tr '+/' 'ab')"
    {
      echo "export APP_BOOTSTRAP_USERNAME=doctor"
      echo "export APP_BOOTSTRAP_PASSWORD=$password"
    } >> "$SECRETS_FILE"
    echo "Local doctor account: username 'doctor', initial password '$password' (change required at first login)"
  fi
}

case "${1:-}" in
  up)     docker compose up -d --build --wait postgres s3 mailpit
          # the bucket is versioned like in production (the emulator creates the bucket itself)
          curl -fsS -X PUT "http://localhost:9090/${S3_BUCKET:-patientvault-files-local}?versioning" \
            -H 'Content-Type: application/xml' \
            -d '<VersioningConfiguration xmlns="http://s3.amazonaws.com/doc/2006-03-01/"><Status>Enabled</Status></VersioningConfiguration>' ;;
  down)   docker compose down ;;
  logs)   docker compose logs -f ;;
  run)    ensure_dev_secrets
          # shellcheck disable=SC1090
          source "$SECRETS_FILE"
          SPRING_PROFILES_ACTIVE=local ./mvnw spring-boot:run ;;
  reset)  docker compose down -v; rm -f "$SECRETS_FILE" ;;
  genkey) echo "v1:$(genkey)" ;;
  *)      echo "usage: ./dev {up|down|logs|run|reset|genkey}"; exit 1 ;;
esac
